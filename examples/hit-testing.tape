Output media/hit-after-02.gif
Set Width 1440
Set Height 720
Set FontSize 22
Set Theme "Aardvark Ink"
Set Shell "bash --noprofile --norc"
Set FontFamily "JetBrains Mono"
Hide
Type "\"$RATATUI_DIFF_VIEWER\" --aardvark-ink"
Enter
Wait+Screen /Unified/
Type "p"
Wait+Screen /Pointer/
Show
Screenshot media/hit-after-02.png
Hide
Type "q"
